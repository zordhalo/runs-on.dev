{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "runs-on.dev registry record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "owner",
    "claimedAt",
    "records"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 32,
      "pattern": "^[a-z0-9]([a-z0-9-]{0,30}[a-z0-9])?$",
      "not": {
        "pattern": "^..--"
      }
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "github"
      ],
      "properties": {
        "github": {
          "type": "string"
        }
      }
    },
    "claimedAt": {
      "type": "string",
      "format": "date-time"
    },
    "records": {
      "$ref": "#/$defs/records"
    },
    "subdomains": {
      "type": "object",
      "maxProperties": 10,
      "propertyNames": {
        "anyOf": [
          {
            "pattern": "^_?[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
          },
          {
            "pattern": "^_[a-z0-9]([a-z0-9-]{0,61}[a-z0-9]?)?\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9]?)?$"
          },
          {
            "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\._domainkey$"
          }
        ]
      },
      "additionalProperties": {
        "$ref": "#/$defs/subdomainRecords"
      }
    },
    "profile": {
      "$ref": "#/$defs/profile"
    },
    "country": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "bio": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "links": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "url"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https?://"
              }
            }
          }
        }
      }
    },
    "records": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "CNAME": {
          "type": "string",
          "pattern": "^(?=.{1,253}$)([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,}$"
        },
        "A": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)(\\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)){3}$"
          }
        },
        "TXT": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "maxLength": 255,
            "pattern": "[^\\s{}]",
            "allOf": [
              {
                "pattern": "^[\\x20-\\x7E]*$",
                "description": "ASCII only. Vercel 400s a value carrying any other character, and the culprit is usually invisible (a U+200B zero-width space surviving a paste). lib/schema.js applies this to every record value, not just TXT."
              }
            ]
          }
        },
        "MX": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "priority",
              "value"
            ],
            "properties": {
              "priority": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65535
              },
              "value": {
                "type": "string",
                "pattern": "^(?=.{1,253}$)([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,}$"
              }
            }
          },
          "description": "Vercel keys MX uniqueness on (name, type, host) and ignores priority, so the same host listed twice is rejected however the priorities differ. lib/schema.js enforces that; JSON Schema cannot express it, because uniqueItems compares whole items and {1,h} differs from {5,h}."
        },
        "URL": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "required": [
                "CNAME"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "A"
                    ]
                  },
                  {
                    "required": [
                      "TXT"
                    ]
                  },
                  {
                    "required": [
                      "MX"
                    ]
                  }
                ]
              }
            },
            {
              "not": {
                "required": [
                  "CNAME"
                ]
              }
            }
          ]
        },
        {
          "oneOf": [
            {
              "required": [
                "URL"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "CNAME"
                    ]
                  },
                  {
                    "required": [
                      "A"
                    ]
                  },
                  {
                    "required": [
                      "TXT"
                    ]
                  },
                  {
                    "required": [
                      "MX"
                    ]
                  }
                ]
              }
            },
            {
              "not": {
                "required": [
                  "URL"
                ]
              }
            }
          ]
        }
      ]
    },
    "subdomainRecords": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "CNAME": {
          "$ref": "#/$defs/records/properties/CNAME"
        },
        "A": {
          "$ref": "#/$defs/records/properties/A"
        },
        "TXT": {
          "$ref": "#/$defs/records/properties/TXT"
        },
        "MX": {
          "$ref": "#/$defs/records/properties/MX"
        }
      },
      "oneOf": [
        {
          "required": [
            "CNAME"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "A"
                ]
              },
              {
                "required": [
                  "TXT"
                ]
              },
              {
                "required": [
                  "MX"
                ]
              }
            ]
          }
        },
        {
          "not": {
            "required": [
              "CNAME"
            ]
          }
        }
      ]
    }
  }
}
